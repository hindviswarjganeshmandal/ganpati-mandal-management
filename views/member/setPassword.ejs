<!DOCTYPE html>
<html>
<head>
    <title>Set Password</title>
</head>
<body>

<h2>Create Your Password</h2>

<form method="POST" action="/admin/member/set-password/<%= token %>">

    <input
        type="password"
        name="password"
        placeholder="New Password"
        required>

    <br><br>

    <button type="submit">
        Save Password
    </button>

</form>

</body>
</html>