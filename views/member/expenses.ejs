<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Expenses</title>

    <link rel="stylesheet" href="/css/member-dashboard.css">
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css">

</head>

<body>

<div class="dashboard">

    <!-- Sidebar -->
    <aside class="sidebar">

        <div class="logo">

            <img src="/images/logo.png">

            <h2>Ganpati Mandal</h2>

        </div>

        <ul>

            <li>
                <a href="/member/dashboard">
                    <i class="fa-solid fa-house"></i>
                    Dashboard
                </a>
            </li>

            <li>
                <a href="/member/add-expense">
                    <i class="fa-solid fa-wallet"></i>
                    Add Expense
                </a>
            </li>

            <li class="active">
                <a href="/member/expenses">
                    <i class="fa-solid fa-list"></i>
                    My Expenses
                </a>
            </li>

            <li>
                <a href="/member/profile">
                    <i class="fa-solid fa-user"></i>
                    Profile
                </a>
            </li>

            <li>
                <a href="/member/logout">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    Logout
                </a>
            </li>

        </ul>

    </aside>

    <main class="content">

        <header>

            <h1>My Expenses</h1>

        </header>

        <div class="table-section">

            <table>

                <thead>

                    <tr>

                        <th>Date</th>

                        <th>Category</th>

                        <th>Item</th>

                        <th>Qty</th>

                        <th>Price</th>

                        <th>Total</th>

                        <th>Status</th>

                        <th>Bill</th>

                    </tr>

                </thead>

                <tbody>

                <% if(expenses.length > 0){ %>

                    <% expenses.forEach(expense=>{ %>

                    <tr>

                        <td><%= expense.expense_date %></td>

                        <td><%= expense.category %></td>

                        <td><%= expense.item_name %></td>

                        <td><%= expense.quantity %></td>

                        <td>₹ <%= expense.price %></td>

                        <td><strong>₹ <%= expense.total %></strong></td>

                        <td>

                            <span class="status <%= expense.status.toLowerCase() %>">

                                <%= expense.status %>

                            </span>

                        </td>

                        <td>

                            <% if(expense.bill){ %>

                                <a href="/uploads/bills/<%= expense.bill %>" target="_blank">

                                    <i class="fa-solid fa-file"></i>

                                </a>

                            <% }else{ %>

                                -

                            <% } %>

                        </td>

                    </tr>

                    <% }) %>

                <% } else { %>

                    <tr>

                        <td colspan="8">

                            No Expense Found

                        </td>

                    </tr>

                <% } %>

                </tbody>

            </table>

        </div>

    </main>

</div>

</body>
</html>