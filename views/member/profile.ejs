<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Profile</title>

    <link rel="stylesheet" href="/css/member-dashboard.css">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css">

</head>

<body>

<div class="dashboard">

    <!-- Sidebar -->

    <aside class="sidebar">

        <div class="logo">

            <img src="/images/logo.png">

            <h2>Ganpati Mandal</h2>

        </div>

        <ul>

            <li>
                <a href="/member/dashboard">
                    <i class="fa-solid fa-house"></i>
                    Dashboard
                </a>
            </li>

            <li>
                <a href="/member/add-expense">
                    <i class="fa-solid fa-wallet"></i>
                    Add Expense
                </a>
            </li>

            <li>
                <a href="/member/expenses">
                    <i class="fa-solid fa-list"></i>
                    My Expenses
                </a>
            </li>

            <li class="active">
                <a href="/member/profile">
                    <i class="fa-solid fa-user"></i>
                    My Profile
                </a>
            </li>

            <li>
                <a href="/member/logout">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    Logout
                </a>
            </li>

        </ul>

    </aside>

    <!-- Main Content -->

    <main class="content">

        <header>

            <h1>My Profile</h1>

        </header>

        <div class="form-card">

            <form
                action="/member/profile"
                method="POST"
                enctype="multipart/form-data">

                <div style="text-align:center;margin-bottom:25px;">

                    <% if(member.profile_photo){ %>

                        <img
                            src="/uploads/profile/<%= member.profile_photo %>"
                            style="width:140px;height:140px;border-radius:50%;object-fit:cover;border:4px solid #ff9800;">

                    <% } else { %>

                        <img
                            src="/images/user.png"
                            style="width:140px;height:140px;border-radius:50%;">

                    <% } %>

                    <br><br>

                    <input
                        type="file"
                        name="profile_photo">

                    <input
                        type="hidden"
                        name="oldPhoto"
                        value="<%= member.profile_photo %>">

                </div>

                <div class="grid">

                    <div class="form-group">

                        <label>Full Name</label>

                        <input
                            type="text"
                            name="fullname"
                            value="<%= member.fullname %>"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Mobile Number</label>

                        <input
                            type="text"
                            name="phone"
                            value="<%= member.phone %>"
                            required>

                    </div>

                    <div class="form-group">

                        <label>Email</label>

                        <input
                            type="email"
                            name="email"
                            value="<%= member.email %>">

                    </div>

                    <div class="form-group">

                        <label>Department</label>

                        <input
                            type="text"
                            name="department"
                            value="<%= member.department %>">

                    </div>

                    <div class="form-group">

                        <label>Date of Birth</label>

                        <input
                            type="date"
                            name="dob"
                            value="<%= member.dob %>">

                    </div>

                    <div class="form-group">

                        <label>Gender</label>

                        <select name="gender">

                            <option value="Male"
                                <%= member.gender=="Male"?"selected":"" %>>
                                Male
                            </option>

                            <option value="Female"
                                <%= member.gender=="Female"?"selected":"" %>>
                                Female
                            </option>

                            <option value="Other"
                                <%= member.gender=="Other"?"selected":"" %>>
                                Other
                            </option>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Blood Group</label>

                        <input
                            type="text"
                            name="blood_group"
                            value="<%= member.blood_group %>">

                    </div>

                    <div class="form-group">

                        <label>Occupation</label>

                        <input
                            type="text"
                            name="occupation"
                            value="<%= member.occupation %>">

                    </div>

                    <div class="form-group full">

                        <label>Address</label>

                        <textarea
                            name="address"
                            rows="4"><%= member.address %></textarea>

                    </div>

                </div>

                <button
                    type="submit"
                    class="btn">

                    <i class="fa-solid fa-floppy-disk"></i>

                    Update Profile

                </button>

            </form>

        </div>

    </main>

</div>

</body>
</html>