<!DOCTYPE html>
<html lang="en">
<% function formatDate(date) { if (!date) return "-" ; return new Date(date).toLocaleDateString("en-GB", {
    day: "2-digit" , month: "short" , year: "numeric" }); } %>

    <head>

        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>Member Dashboard</title>

        <link rel="stylesheet" href="/css/member-dashboard.css">

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css">

    </head>

    <body>

        <div class="dashboard">

            <!-- Sidebar -->
            <aside class="sidebar">

                <div class="logo">

                    <img src="/images/logo.png" alt="Logo">

                    <h2>Ganpati Mandal</h2>

                </div>

                <ul>

                    <li class="active">
                        <a href="/member/dashboard">
                            <i class="fa-solid fa-house"></i>
                            Dashboard
                        </a>
                    </li>

                    <li>
                        <a href="/member/add-expense">
                            <i class="fa-solid fa-wallet"></i>
                            Add Expense
                        </a>
                    </li>

                    <li>
                        <a href="/member/expenses">
                            <i class="fa-solid fa-list"></i>
                            My Expenses
                        </a>
                    </li>

                    <li>
                        <a href="/member/profile">
                            <i class="fa-solid fa-user"></i>
                            My Profile
                        </a>
                    </li>

                    <li>
                        <a href="/member/password">
                            <i class="fa-solid fa-key"></i>
                            Change Password
                        </a>
                    </li>

                    <li>
                        <a href="/member/logout">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            Logout
                        </a>
                    </li>

                </ul>

            </aside>

            <!-- Main Content -->
            <main class="content">

                <!-- Header -->
                <header>

                    <div>

                        <h1>Welcome, <%= member.fullname %>
                        </h1>

                        <p>
                            Department :
                            <strong>
                                <%= member.department %>
                            </strong>
                        </p>

                    </div>

                    <div class="profile">

                        <i class="fa-solid fa-user-circle"></i>

                    </div>

                </header>

                <!-- Statistics -->
                <section class="cards">

                    <div class="card">

                        <i class="fa-solid fa-indian-rupee-sign"></i>

                        <h3>Total Expenses</h3>

                        <h2>₹ <%= totalAmount %>
                        </h2>

                    </div>

                    <div class="card pending">

                        <i class="fa-solid fa-clock"></i>

                        <h3>Pending</h3>

                        <h2>
                            <%= pending %>
                        </h2>

                    </div>

                    <div class="card approved">

                        <i class="fa-solid fa-circle-check"></i>

                        <h3>Approved</h3>

                        <h2>
                            <%= approved %>
                        </h2>

                    </div>

                    <div class="card rejected">

                        <i class="fa-solid fa-circle-xmark"></i>

                        <h3>Rejected</h3>

                        <h2>
                            <%= rejected %>
                        </h2>

                    </div>

                </section>

                <!-- Recent Expenses -->
                <section class="table-section">

                    <div class="table-header">

                        <h2>Recent Expenses</h2>

                        <a href="/member/add-expense" class="btn">

                            + Add Expense

                        </a>

                    </div>

                    <table>

                        <thead>

                            <tr>

                                <th>Date</th>

                                <th>Item</th>

                                <th>Category</th>

                                <th>Total</th>

                                <th>Status</th>

                            </tr>

                        </thead>

                        <tbody>

                            <% if(expenses.length>0){ %>

                                <% expenses.forEach(expense=>{ %>

                                    <tr>

                                        <td>
                                            <%= formatDate(expense.expense_date) %>
                                        </td>

                                        <td>
                                            <%= expense.item_name %>
                                        </td>

                                        <td>
                                            <%= expense.category %>
                                        </td>

                                        <td>₹ <%= expense.total %>
                                        </td>

                                        <td>

                                            <span class="status <%= expense.status.toLowerCase() %>">

                                                <%= expense.status %>

                                            </span>

                                        </td>

                                    </tr>

                                    <% }) %>

                                        <% } else { %>

                                            <tr>

                                                <td colspan="5">

                                                    No expenses added yet.

                                                </td>

                                            </tr>

                                            <% } %>

                        </tbody>

                    </table>

                </section>

            </main>

        </div>

    </body>

</html>