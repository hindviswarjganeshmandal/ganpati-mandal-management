<%- include("../partials/header") %>
    <%- include("../partials/navbar") %>

        <div class="container">

            <h1>Donation Management</h1>

            <table class="table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Amount</th>
                        <th>Screenshot</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    <% donations.forEach(donation=> { %>

                        <tr>

                            <td>
                                <%= donation.id %>
                            </td>

                            <td>
                                <%= donation.fullname %>
                            </td>

                            <td>
                                <%= donation.email %>
                            </td>

                            <td>₹ <%= donation.amount %>
                            </td>

                            <td>
                                <img src="/uploads/donations/<%= donation.screenshot %>" width="100" height="100"
                                    style="object-fit:cover;border-radius:8px;">
                            </td>

                            <td>
                                <%= donation.status %>
                            </td>

                            <% if(donation.status==="Pending" ){ %>

                                <a class="btn btn-success" href="/admin/donations/verify/<%= donation.id %>">
                                    ✅ Verify
                                </a>

                                <a class="btn btn-danger" href="/admin/donations/reject/<%= donation.id %>">
                                    ❌ Reject
                                </a>

                                <% } else { %>

                                    <span class="btn btn-success">
                                        <%= donation.status %>
                                    </span>

                                    <br><br>

                                    <a class="btn btn-primary" href="/admin/donations/receipt/<%= donation.id %>">
                                        📄 Download Receipt
                                    </a>

                                    <% } %>

                        </tr>

                        <% }) %>

                </tbody>

            </table>

        </div>


        <%- include("../partials/footer") %>