<%- include("partials/sidebar") %>
<%- include("partials/topbar") %>

<link rel="stylesheet" href="/css/admin.css">
<link rel="stylesheet" href="/css/donations.css">

<div class="main-content">

    <div class="container">

        <h1>Donation Management</h1>

        <table class="table">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Amount</th>
                    <th>Screenshot</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                <% donations.forEach(donation => { %>

                <tr>

                    <td><%= donation.id %></td>

                    <td><%= donation.fullname %></td>

                    <td><%= donation.email %></td>

                    <td class="amount">₹ <%= donation.amount %></td>

                    <td>
                        <img
                            src="<%= donation.screenshot %>"
                            width="90"
                            height="90"
                            style="object-fit:cover;border-radius:10px;">
                    </td>

                    <td>
                        <span class="status <%= donation.status.toLowerCase() %>">
                            <%= donation.status %>
                        </span>
                    </td>

                    <td class="actions">

                        <% if (donation.status === "Pending") { %>

                            <a href="/admin/donations/verify/<%= donation.id %>" class="btn btn-success">
                                Verify
                            </a>

                            <a href="/admin/donations/reject/<%= donation.id %>"
                               class="btn btn-warning"
                               onclick="return confirm('Reject this donation?')">
                                Reject
                            </a>

                        <% } else { %>

                            <span class="btn btn-success">Verified</span>

                            <br><br>

                            <a href="/admin/donations/receipt/<%= donation.id %>"
                               class="btn btn-primary">
                                Receipt
                            </a>

                        <% } %>

                        <br><br>

                        <a href="/admin/donations/delete/<%= donation.id %>"
                           class="btn btn-danger"
                           onclick="return confirm('Delete this donation permanently?')">
                            Delete
                        </a>

                    </td>

                </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>