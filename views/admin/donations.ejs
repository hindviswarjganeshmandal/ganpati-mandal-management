<%- include("partials/sidebar") %>
    <%- include("partials/topbar") %>
        <link rel="stylesheet" href="/css/admin.css">
        <link rel="stylesheet" href="/css/donations.css">

        <div class="container">

            <h1>Donation Management</h1>

            <table class="table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Amount</th>
                        <th>Screenshot</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    <% donations.forEach(donation=> { %>

                        <tr>

                            <td>
                                <%= donation.id %>
                            </td>

                            <td>
                                <%= donation.fullname %>
                            </td>

                            <td>
                                <%= donation.email %>
                            </td>

                            <td class="amount">
                                ₹ <%= donation.amount %>
                            </td>

                            <td>
                                <img src="<%= photo.image %>" class="donation-image" alt="Payment Screenshot">
                            </td>

                            <td>
                                <span class="status <%= donation.status.toLowerCase() %>">
                                    <%= donation.status %>
                                </span>
                            </td>

                            <!-- IMPORTANT: Action buttons must be inside TD -->
                            <td class="actions">

                                <% if (donation.status==="Pending" ) { %>

                                    <a class="btn btn-success" href="/admin/donations/verify/<%= donation.id %>">
                                        ✅ Verify
                                    </a>

                                    <a class="btn btn-danger" href="/admin/donations/reject/<%= donation.id %>">
                                        ❌ Reject
                                    </a>

                                    <% } else { %>

                                        <span class="btn btn-success">
                                            <%= donation.status %>
                                        </span>

                                        <a class="btn btn-primary" href="/admin/donations/receipt/<%= donation.id %>">
                                            📄 Download Receipt
                                        </a>

                                        <% } %>

                            </td>

                        </tr>

                        <% }) %>

                </tbody>

            </table>

        </div>