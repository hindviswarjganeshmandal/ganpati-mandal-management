<%- include("../partials/header") %>

    <link rel="stylesheet" href="/css/admin.css">

    <%- include("partials/sidebar") %>
        <%- include("partials/topbar") %>

            <div class="main-content">

                <h1>Member Management</h1>

                <form action="/admin/members" method="GET" style="margin-bottom:20px;">
                    <input type="text" name="search" placeholder="🔍 Search by Name or Email"
                        value="<%= search || '' %>" style="width:300px;padding:10px;">

                    <button class="btn btn-primary">Search</button>
                </form>

                <table class="table">

                    <thead>
                        <tr>
                            <th>Photo</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Income</th>
                            <th>Expense</th>
                            <th>Status</th>
                            <th>Save</th>
                            <th>Delete</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% members.forEach(member=> { %>

                            <tr>

                                <td>
                                    <img src="<%= member.photo %>" width="60" height="60"
                                        style="border-radius:50%;object-fit:cover;">
                                </td>

                                <td>
                                    <%= member.fullname %>
                                </td>

                                <td>
                                    <%= member.email %>
                                </td>

                                <td>
                                    <%= member.phone %>
                                </td>

                                <form action="/admin/members/permission/<%= member.id %>" method="POST">

                                    <td style="text-align:center;">
                                        <input type="checkbox" name="can_add_income" value="1" <%=member.can_add_income
                                            ? "checked" : "" %>>
                                    </td>

                                    <td style="text-align:center;">
                                        <input type="checkbox" name="can_add_expense" value="1"
                                            <%=member.can_add_expense ? "checked" : "" %>>
                                    </td>

                                    <td>
                                    <td>
                                        <% if(member.status==="Pending" ){ %>
                                            <span class="badge bg-warning">Pending</span>
                                            <% } else { %>
                                                <span class="badge bg-success">Approved</span>
                                                <% } %>
                                    </td>
                                    <button class="btn btn-success" type="submit">
                                        Save
                                    </button>
                                    </td>

                                </form>

                                <td>
                                    <% if(member.status==="Pending" ){ %>

                                        <a href="/admin/approve/<%= member.id %>" class="btn btn-success">
                                            Approve
                                        </a>

                                        <a href="/admin/reject/<%= member.id %>" class="btn btn-danger">
                                            Reject
                                        </a>

                                        <% } else { %>

                                            <a href="/admin/members/delete/<%= member.id %>" class="btn btn-danger"
                                                onclick="return confirm('Delete this member?')">
                                                Delete
                                            </a>

                                            <% } %>
                                </td>
                                <td>
                                    <input type="checkbox" name="can_login" value="1" <%=member.can_login ? "checked"
                                        : "" %>>
                                </td>

                            </tr>

                            <% }) %>

                    </tbody>

                </table>

                <div style="margin-top:20px;text-align:center;">

                    <% if(currentPage>1){ %>

                        <a class="btn btn-primary" href="/admin/members?page=<%= currentPage-1 %>">
                            Previous
                        </a>

                        <% } %>

                            <span style="padding:10px 20px;">
                                Page <%= currentPage %> of <%= totalPages %>
                            </span>

                            <% if(currentPage<totalPages){ %>

                                <a class="btn btn-primary" href="/admin/members?page=<%= currentPage+1 %>">
                                    Next
                                </a>

                                <% } %>

                </div>

            </div>