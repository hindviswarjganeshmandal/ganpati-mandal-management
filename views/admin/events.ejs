<%- include("../partials/header") %>

    <link rel="stylesheet" href="/css/admin.css">

    <%- include("partials/sidebar") %>
        <%- include("partials/topbar") %>

            <div class="main-content">

                <h1>Event Management</h1>

                <form action="/admin/events/add" method="POST" enctype="multipart/form-data">
                    <input type="text" name="title" placeholder="Event Title" required>

                    <br><br>

                    <input type="date" name="event_date" required>

                    <br><br>

                    <input type="text" name="event_time" placeholder="Event Time">

                    <br><br>

                    <input type="text" name="location" placeholder="Location">

                    <br><br>

                    <textarea name="description" rows="5" placeholder="Event Description"></textarea>

                    <br><br>

                    <button type="submit">
                        Add Event
                    </button>

                </form>

                <hr>

                <h2>All Events</h2>

                <table class="table">

                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Title</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Location</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% events.forEach(event=> { %>

                            <tr>

    <td>

        <% if(event.image){ %>

            <img
                src="/uploads/events/<%= event.image %>"
                width="80"
                height="60"
                style="border-radius:8px;object-fit:cover;">

        <% } else { %>

            No Image

        <% } %>

    </td>

    <td><%= event.title %></td>

    <td><%= new Date(event.event_date).toLocaleDateString("en-IN") %></td>

    <td><%= event.event_time %></td>

    <td><%= event.location %></td>

    <td>

        <a
        href="/admin/events/edit/<%= event.id %>"
        class="btn btn-primary">

        Edit

        </a>

        <a
        href="/admin/events/delete/<%= event.id %>"
        onclick="return confirm('Delete this Event?')"
        class="btn btn-danger">

        Delete

        </a>

    </td>

</tr>

                            <% }) %>

                    </tbody>

                </table>

            </div>


            <%- include("../partials/footer") %>