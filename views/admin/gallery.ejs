<link rel="stylesheet" href="/css/admin-gallery.css">
<div class="gallery-management">

    <div class="gallery-header">
        <div>
            <h1>
                <i class="fa-solid fa-images"></i>
                Gallery Management
            </h1>

            <p>Upload and manage Mandal gallery photos</p>
        </div>
    </div>

    <!-- Upload Section -->

    <div class="gallery-upload-card">

        <div class="card-title">
            <i class="fa-solid fa-cloud-arrow-up"></i>

            <div>
                <h2>Upload Photo</h2>
                <p>Add a new photo to the Mandal gallery</p>
            </div>
        </div>

        <form action="/admin/gallery/upload" method="POST" enctype="multipart/form-data" class="gallery-form">

            <div class="form-group">

                <label>
                    <i class="fa-solid fa-heading"></i>
                    Photo Title
                </label>

                <input type="text" name="title" placeholder="Enter photo title" required>

            </div>

            <div class="form-group">

                <label>
                    <i class="fa-solid fa-image"></i>
                    Select Photo
                </label>

                <input type="file" name="image" accept="image/*" required>

            </div>

            <button type="submit" class="upload-btn">

                <i class="fa-solid fa-upload"></i>

                Upload Photo

            </button>

        </form>

    </div>


    <!-- Gallery -->

    <div class="gallery-list-card">

        <div class="gallery-list-header">

            <div>
                <h2>
                    <i class="fa-solid fa-photo-film"></i>
                    Gallery Photos
                </h2>

                <p>Uploaded Mandal photos</p>
            </div>

            <span class="photo-count">
                <%= photos.length %> Photos
            </span>

        </div>


<div class="gallery-grid">

    <% if (messages.success) { %>
        <div class="success-message">
            <i class="fa-solid fa-circle-check"></i>
            <%= messages.success %>
        </div>
    <% } %>

    <% photos.forEach(photo => { %>

        <div class="gallery-item">

            <img
                src="<%= photo.image %>"
                alt="<%= photo.title %>"
                class="gallery-image">

            <h4><%= photo.title %></h4>

            <a
                href="/admin/gallery/delete/<%= photo.id %>"
                class="delete-btn"
                onclick="return confirm('Are you sure you want to delete this photo?')">

                <i class="fa-solid fa-trash"></i>
                Delete

            </a>

        </div>

    <% }) %>

</div>

</div>
<script>
    setTimeout(() => {

        const notification = document.getElementById("successNotification");

        if (notification) {
            notification.style.opacity = "0";

            setTimeout(() => {
                notification.remove();
            }, 300);
        }

    }, 3000);
</script>