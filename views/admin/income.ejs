<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<%- include("partials/sidebar") %>
<%- include("partials/topbar") %>
<title>Income Management</title>

<link rel="stylesheet" href="/css/admin.css">
<link rel="stylesheet" href="/css/income.css">
<link rel="stylesheet" href="/css/responsive.css">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css">

</head>
<body>


<div class="main-content">

<div class="container">

<div class="page-title">

<div>
<h1>Income Management</h1>
<p>Manage all Mandal income records</p>
</div>

</div>

<div class="cards">

<div class="card">

<i class="fa-solid fa-wallet"></i>

<h3>Total Income</h3>

<h2>₹ <%= totalIncome %></h2>

</div>

</div>

<!-- ================= ADD INCOME ================= -->

<div class="box">

    <h2>
        <i class="fa-solid fa-circle-plus"></i>
        Add New Income
    </h2>

    <form action="/admin/income/add" method="POST">

        <div class="grid">

            <div class="form-group">

                <label>Income Date</label>

                <input
                    type="date"
                    name="income_date"
                    required>

            </div>

            <div class="form-group">

                <label>Income Source</label>

                <select
                    name="source"
                    required>

                    <option value="">Select Source</option>

                    <option>Donation</option>

                    <option>Sponsorship</option>

                    <option>Membership Fee</option>

                    <option>Festival Collection</option>

                    <option>Advertisement</option>

                    <option>Other</option>

                </select>

            </div>

            <div class="form-group">

                <label>Amount (₹)</label>

                <input
                    type="number"
                    name="amount"
                    placeholder="Enter Amount"
                    required>

            </div>

            <div class="form-group">

                <label>Received From</label>

                <input
                    type="text"
                    name="received_from"
                    placeholder="Person / Organization">

            </div>

            <div class="form-group">

                <label>Payment Method</label>

                <select name="payment_method">

                    <option>Cash</option>

                    <option>UPI</option>

                    <option>Bank Transfer</option>

                    <option>Cheque</option>

                </select>

            </div>

            <div class="form-group full">

                <label>Description</label>

                <textarea
                    name="description"
                    rows="4"
                    placeholder="Write income description..."></textarea>

            </div>

        </div>

        <br>

        <button class="btn">

            <i class="fa-solid fa-floppy-disk"></i>

            Save Income

        </button>

    </form>

</div>

</div>

</div>
<div class="box">

    <h2>
        <i class="fa-solid fa-filter"></i>
        Search Income
    </h2>

    <form action="/admin/income" method="GET">

        <div class="grid">

            <div class="form-group">

                <label>Search</label>

                <input
                    type="text"
                    name="search"
                    placeholder="Source / Received From"
                    value="<%= search || '' %>">

            </div>

            <div class="form-group">

                <label>Month</label>

                <select name="month">

                    <option value="">All Months</option>

                    <% for(let i=1;i<=12;i++){ %>

                    <option
                        value="<%= i %>"
                        <%= month==i ? "selected" : "" %>>

                        <%= i %>

                    </option>

                    <% } %>

                </select>

            </div>

            <div class="form-group">

                <label>Year</label>

                <input
                    type="number"
                    name="year"
                    placeholder="2026"
                    value="<%= year || '' %>">

            </div>

            <div class="form-group">

                <label>Payment</label>

                <select name="payment_method">

                    <option value="">All</option>

                    <option value="Cash">Cash</option>

                    <option value="UPI">UPI</option>

                    <option value="Bank Transfer">Bank Transfer</option>

                    <option value="Cheque">Cheque</option>

                </select>

            </div>

        </div>

        <br>

        <button class="btn">

            <i class="fa-solid fa-magnifying-glass"></i>

            Search

        </button>

        <a href="/admin/income" class="btn btn-danger">

            Reset

        </a>

    </form>

</div>
<!-- ================= INCOME HISTORY ================= -->

<div class="box">

    <div class="table-header">

        <h2>
            <i class="fa-solid fa-table"></i>
            Income History
        </h2>

    </div>

    <div class="table-box">

        <table>

            <thead>

                <tr>

                    <th>#</th>

                    <th>Date</th>

                    <th>Source</th>

                    <th>Amount</th>

                    <th>Received From</th>

                    <th>Payment</th>

                    <th>Description</th>

                    <th>Action</th>

                </tr>

            </thead>

            <tbody>

                <% if(income.length > 0){ %>

                    <% income.forEach((item,index)=>{ %>

                    <tr>

                        <td><%= index + 1 %></td>

                        <td><%= item.income_date %></td>

                        <td>
                            <span class="badge">
                                <%= item.source %>
                            </span>
                        </td>

                        <td class="amount">
                            ₹ <%= item.amount %>
                        </td>

                        <td><%= item.received_from %></td>

                        <td><%= item.payment_method %></td>

                        <td><%= item.description %></td>

                        <td>

                            <div class="action">

                                <a
                                    href="/admin/income/edit/<%= item.id %>"
                                    class="edit"
                                    title="Edit">

                                    <i class="fa-solid fa-pen"></i>

                                </a>

                                <a
                                    href="/admin/income/delete/<%= item.id %>"
                                    class="delete"
                                    onclick="return confirm('Delete this income record?')"
                                    title="Delete">

                                    <i class="fa-solid fa-trash"></i>

                                </a>

                            </div>

                        </td>

                    </tr>

                    <% }) %>

                <% } else { %>

                    <tr>

                        <td colspan="8" style="text-align:center;padding:30px;">

                            <i class="fa-solid fa-circle-info"></i>

                            No income records found.

                        </td>

                    </tr>

                <% } %>

            </tbody>

        </table>

    </div>

</div>

</body>
</html>