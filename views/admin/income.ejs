<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Income Management</title>

<link rel="stylesheet" href="/css/admin.css">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css">

</head>

<body>

<div class="container">

    <h1>Income Management</h1>

    <!-- Total Income -->

    <div class="cards">

        <div class="card income">

            <i class="fa-solid fa-money-bill-wave"></i>

            <h3>Total Income</h3>

            <h2>₹ <%= totalIncome %></h2>

        </div>

    </div>

    <!-- Add Income -->

    <div class="box">

        <h2>Add Income</h2>

        <form action="/admin/income/add" method="POST">

            <div class="grid">

                <input
                    type="date"
                    name="income_date"
                    required>

                <input
                    type="text"
                    name="source"
                    placeholder="Income Source"
                    required>

                <input
                    type="number"
                    step="0.01"
                    name="amount"
                    placeholder="Amount"
                    required>

                <input
                    type="text"
                    name="received_from"
                    placeholder="Received From"
                    required>

                <select name="payment_method">

                    <option>Cash</option>
                    <option>UPI</option>
                    <option>Bank</option>
                    <option>Cheque</option>

                </select>

                <input
                    type="text"
                    name="reference_no"
                    placeholder="Reference Number">

                <textarea
                    class="full"
                    name="description"
                    placeholder="Description"></textarea>

            </div>

            <br>

            <button class="btn">

                <i class="fa-solid fa-plus"></i>

                Add Income

            </button>

        </form>

    </div>

    <!-- Income Table -->

    <div class="box">

        <h2>Income History</h2>

        <table>

            <thead>

                <tr>

                    <th>Date</th>
                    <th>Source</th>
                    <th>Amount</th>
                    <th>Received From</th>
                    <th>Payment</th>
                    <th>Reference</th>
                    <th>Action</th>

                </tr>

            </thead>

            <tbody>

            <% if(income.length > 0){ %>

                <% income.forEach(item => { %>

                <tr>

                    <td><%= item.income_date %></td>

                    <td><%= item.source %></td>

                    <td>₹ <%= item.amount %></td>

                    <td><%= item.received_from %></td>

                    <td><%= item.payment_method %></td>

                    <td><%= item.reference_no || "-" %></td>

                    <td>

                        <a
                        href="/admin/income/delete/<%= item.id %>"
                        onclick="return confirm('Delete this income record?')">

                            <i class="fa-solid fa-trash"></i>

                        </a>

                    </td>

                </tr>

                <% }) %>

            <% } else { %>

                <tr>

                    <td colspan="7" style="text-align:center;">

                        No income records found.

                    </td>

                </tr>

            <% } %>

            </tbody>

        </table>

    </div>

</div>

</body>
</html>