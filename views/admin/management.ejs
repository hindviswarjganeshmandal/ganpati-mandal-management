<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Management</title>

    <link rel="stylesheet" href="/css/admin.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css">

</head>

<body>

    <div class="container">

        <h1>Management Dashboard</h1>

        <!-- Dashboard Cards -->

        <div class="cards">

            <div class="card income">
                <h3>Total Income</h3>
                <h2>₹ <%= income %>
                </h2>
            </div>

            <div class="card expense">
                <h3>Total Expense</h3>
                <h2>₹ <%= expense %>
                </h2>
            </div>

            <div class="card balance">
                <h3>Current Balance</h3>
                <h2>₹ <%= balance %>
                </h2>
            </div>

        </div>

        <!-- Add Transaction -->

        <div class="box">

            <h2>Add Transaction</h2>

            <form action="/admin/management/add" method="POST">

                <div class="grid">

                    <input type="date" name="transaction_date" required>

                    <select name="type" required>

                        <option value="Income">Income</option>
                        <option value="Expense">Expense</option>

                    </select>

                    <input type="text" name="category" placeholder="Category" required>

                    <input type="text" name="item_name" placeholder="Item Name" required>

                    <input type="number" id="quantity" name="quantity" value="1" required>

                    <input type="number" id="price" name="price" value="0" required>

                    <input type="number" id="total" name="total" readonly>

                    <select name="member_id">

                        <option value="">Select Member</option>

                        <% members.forEach(member=>{ %>

                            <option value="<%= member.id %>">
                                <%= member.fullname %>
                            </option>

                            <% }) %>

                    </select>

                    <textarea name="description" placeholder="Description">
                </textarea>

                </div>

                <button type="submit">

                    Save Transaction

                </button>

            </form>

        </div>
        <form method="GET" action="/admin/management">

            <div class="grid">

                <input type="text" name="search" placeholder="Search Item / Member" value="<%= search %>">

                <select name="type">

                    <option value="">All</option>

                    <option value="Income" <%=type==="Income" ?"selected":"" %>>

                        Income

                    </option>

                    <option value="Expense" <%=type==="Expense" ?"selected":"" %>>

                        Expense

                    </option>

                </select>

                <input type="number" name="month" placeholder="Month" min="1" max="12" value="<%= month %>">

                <input type="number" name="year" placeholder="Year" value="<%= year %>">

                <button class="btn">

                    Search

                </button>

            </div>

        </form>

        <br>
        <!-- Transaction Table -->

        <div class="box">

            <h2>Transaction History</h2>

            <table>

                <thead>

                    <tr>

                        <th>Date</th>
                        <th>Type</th>
                        <th>Item</th>
                        <th>Member</th>
                        <th>Total</th>
                        <th>Action</th>

                    </tr>

                </thead>

                <tbody>

                    <% transactions.forEach(t=>{ %>

                        <tr>

                            <td>
                                <%= t.transaction_date %>
                            </td>

                            <td>
                                <%= t.type %>
                            </td>

                            <td>
                                <%= t.item_name %>
                            </td>

                            <td>
                                <%= t.fullname || "-" %>
                            </td>

                            <td>₹ <%= t.total %>
                            </td>

                            <td>

                                <a href="/admin/management/delete/<%= t.id %>" onclick="return confirm('Delete?')">

                                    Delete

                                </a>

                            </td>

                        </tr>

                        <% }) %>

                </tbody>

            </table>

        </div>

    </div>

    <script>

        const qty = document.getElementById("quantity");
        const price = document.getElementById("price");
        const total = document.getElementById("total");

        function calculate() {

            total.value = (Number(qty.value) || 0) * (Number(price.value) || 0);

        }

        qty.addEventListener("input", calculate);
        price.addEventListener("input", calculate);

        calculate();

    </script>

</body>

</html>